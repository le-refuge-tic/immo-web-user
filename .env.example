VITE_API_URL=http://localhost:3000/api/v1

# Domaine public du site (URL absolues : og:image, canonical, sitemap). Ex : https://refuge.bj
VITE_SITE_URL=
# true UNIQUEMENT en production : sinon robots.txt interdit l'indexation et chaque page est en noindex
VITE_ALLOW_INDEXING=false
# Umami (mesure d'audience sans cookie). Vide = aucun script chargé.
VITE_UMAMI_WEBSITE_ID=
# Script Umami (Umami Cloud par défaut ; à changer si auto-hébergé, et l'ajouter à la CSP de vercel.json)
VITE_UMAMI_SRC=https://cloud.umami.is/script.js
